---
import divisionsData from '../data/divisions.json';
---

<section id="divisions" class="relative w-full pt-[140px] pb-12 select-none overflow-hidden">
  <!-- Section Title (Positioned right aligned as in Figma) -->
  <div class="flex justify-end px-3 mb-2">
    <img
      src="/assets/svg/divisions_title.svg"
      alt="Divisions"
      class="w-[331px] h-[88px] object-contain"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Pagination Pill Header (P5X-style pill buttons row inside pagination.svg frame) -->
  <div class="relative w-[285px] h-[80px] ml-auto mr-4">
    <img
      src="/assets/svg/pagination.svg"
      alt="Pagination Background"
      class="absolute inset-0 w-full h-full object-contain pointer-events-none"
      loading="lazy"
      decoding="async"
    />
    <!-- Division 3-Pills Navigation Window -->
    <div
      id="division-pills-window"
      class="absolute left-[39px] top-[21px] flex items-center gap-[12px] z-10"
    >
      <button
        type="button"
        id="pill-slot-0"
        data-slot="0"
        data-div-idx="0"
        class="division-pill-btn w-[57px] h-[44px] transition-all duration-200 hover:scale-105 active:scale-95 focus:outline-none flex items-center justify-center opacity-100 scale-105"
        aria-label="Division 1"
      >
        <img
          src={divisionsData[0].nav_pill_active}
          alt="Division 1"
          class="pill-img w-full h-full object-contain pointer-events-none"
          loading="lazy"
          decoding="async"
        />
      </button>

      <button
        type="button"
        id="pill-slot-1"
        data-slot="1"
        data-div-idx="1"
        class="division-pill-btn w-[57px] h-[44px] transition-all duration-200 hover:scale-105 active:scale-95 focus:outline-none flex items-center justify-center opacity-70 hover:opacity-100"
        aria-label="Division 2"
      >
        <img
          src={divisionsData[1].nav_pill}
          alt="Division 2"
          class="pill-img w-full h-full object-contain pointer-events-none"
          loading="lazy"
          decoding="async"
        />
      </button>

      <button
        type="button"
        id="pill-slot-2"
        data-slot="2"
        data-div-idx="2"
        class="division-pill-btn w-[57px] h-[44px] transition-all duration-200 hover:scale-105 active:scale-95 focus:outline-none flex items-center justify-center opacity-70 hover:opacity-100"
        aria-label="Division 3"
      >
        <img
          src={divisionsData[2].nav_pill}
          alt="Division 3"
          class="pill-img w-full h-full object-contain pointer-events-none"
          loading="lazy"
          decoding="async"
        />
      </button>
    </div>
  </div>

  <!-- Main Division Stage (Character Artwork + Prev/Next Buttons) -->
  <div class="relative w-full h-[430px] flex items-center justify-center">
    <!-- Character Visual Artwork -->
    <div class="relative z-10 w-[420px] h-[420px] flex items-center justify-center transition-all duration-300 transform" id="div-img-container">
      <img
        id="div-img"
        src={divisionsData[0].image_red}
        alt="Division Visual"
        class="w-full h-full object-contain drop-shadow-[0_10px_25px_rgba(0,0,0,0.9)]"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Role Change Decorative Badge (top right) from SVG -->
    <div
      id="role-change-btn"
      class="absolute top-2 right-2 z-20 cursor-pointer transition-transform hover:scale-105 active:scale-95"
      role="button"
      aria-label="Switch Role Red or Blue"
      tabindex="0"
    >
      <img
        src="/assets/svg/role_change.svg"
        alt="Role Change"
        class="w-[110px] h-auto object-contain drop-shadow-md pointer-events-none"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Prev Arrow Button from SVG -->
    <button
      id="div-prev-btn"
      type="button"
      class="absolute left-2 top-1/2 -translate-y-1/2 z-30 w-[45px] h-[55px] transition-transform hover:scale-110 active:scale-95 focus:outline-none"
      aria-label="Previous Division"
    >
      <img src="/assets/svg/prev_arrow.svg" alt="Previous" class="w-full h-full object-contain" loading="lazy" decoding="async" />
    </button>

    <!-- Next Arrow Button from SVG -->
    <button
      id="div-next-btn"
      type="button"
      class="absolute right-2 top-1/2 -translate-y-1/2 z-30 w-[45px] h-[55px] transition-transform hover:scale-110 active:scale-95 focus:outline-none"
      aria-label="Next Division"
    >
      <img src="/assets/svg/next_arrow.svg" alt="Next" class="w-full h-full object-contain" loading="lazy" decoding="async" />
    </button>
  </div>

  <!-- Division Name Header Badge (Variant of mask_role.svg per division, purely graphical without text overlay) -->
  <div class="relative w-[410px] h-[65px] ml-3 -mt-8 z-30">
    <img
      id="div-name-img"
      src={divisionsData[0].name_svg}
      alt="Division Name"
      class="object-contain"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Description Box with Frame text_m.svg -->
  <div class="relative w-[438px] h-[293px] mx-auto -mt-8 z-20">
    <img
      src="/assets/svg/text_m.svg"
      alt="Description Box"
      class="absolute inset-0 w-full h-full object-fill pointer-events-none"
      loading="lazy"
      decoding="async"
    />

    <!-- Division Description Text -->
    <div class="absolute top-[60px] left-[55px] w-[325px] h-[170px] overflow-y-auto">
      <p id="div-desc" class="font-sans text-white text-[14px] leading-[1.5] text-justify font-normal tracking-tight">
        {divisionsData[0].desc}
      </p>
    </div>
  </div>

  <!-- Division Tag Badge (Variant of name_role.svg per division, purely graphical without text overlay) -->
  <div class="relative w-[350px] h-[124px] ml-3 -mt-14 z-30">
    <img
      id="div-tag-img"
      src={divisionsData[0].tag_svg}
      alt="Division Tag"
      class="object-contain"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<script define:vars={{ divisionsData }}>
  let currentIndex = 0;
  let currentVariant = 'red';
  const total = divisionsData.length;

  const nameImg = document.getElementById('div-name-img');
  const tagImg = document.getElementById('div-tag-img');
  const descEl = document.getElementById('div-desc');
  const imgEl = document.getElementById('div-img');
  const imgContainer = document.getElementById('div-img-container');
  const pillsWindow = document.getElementById('division-pills-window');
  const pillSlots = [
    document.getElementById('pill-slot-0'),
    document.getElementById('pill-slot-1'),
    document.getElementById('pill-slot-2'),
  ];
  const roleChangeBtn = document.getElementById('role-change-btn');

  function renderPills(animDir = 0) {
    const slotIndices = [
      currentIndex,
      (currentIndex + 1) % total,
      (currentIndex + 2) % total,
    ];

    if (animDir !== 0 && pillsWindow) {
      pillsWindow.style.transition = 'transform 0.15s ease-out, opacity 0.15s ease-out';
      pillsWindow.style.transform = animDir > 0 ? 'translateX(-8px)' : 'translateX(8px)';
      pillsWindow.style.opacity = '0.7';
    }

    setTimeout(() => {
      slotIndices.forEach((divIdx, slotIdx) => {
        const btn = pillSlots[slotIdx];
        if (!btn) return;
        btn.setAttribute('data-div-idx', divIdx.toString());
        btn.setAttribute('aria-label', `Division ${divIdx + 1}: ${divisionsData[divIdx].id}`);

        const pillImg = btn.querySelector('.pill-img');
        const item = divisionsData[divIdx];
        const activeSrc = item.nav_pill_active;
        const idleSrc = item.nav_pill;

        if (slotIdx === 0) {
          // Lead/Active slot
          if (pillImg) pillImg.src = activeSrc;
          btn.classList.remove('opacity-70');
          btn.classList.add('opacity-100', 'scale-105');
        } else {
          // Idle slots
          if (pillImg) pillImg.src = idleSrc;
          btn.classList.remove('opacity-100', 'scale-105');
          btn.classList.add('opacity-70');
        }
      });

      if (pillsWindow) {
        pillsWindow.style.transform = 'translateX(0)';
        pillsWindow.style.opacity = '1';
      }
    }, animDir !== 0 ? 150 : 0);
  }

  function updateDivision(index, animDir = 0) {
    currentIndex = index;

    if (imgContainer) {
      imgContainer.style.opacity = '0';
      imgContainer.style.transform = 'scale(0.95)';
    }

    renderPills(animDir);

    setTimeout(() => {
      const item = divisionsData[index];
      if (nameImg) nameImg.src = item.name_svg;
      if (tagImg) tagImg.src = item.tag_svg;
      if (descEl) descEl.textContent = item.desc;
      if (imgEl) {
        imgEl.src = currentVariant === 'red' ? item.image_red : item.image_blue;
        imgEl.alt = `${item.id} (${currentVariant})`;
      }

      if (imgContainer) {
        imgContainer.style.opacity = '1';
        imgContainer.style.transform = 'scale(1)';
      }
    }, 150);
  }

  // Role Change Switch listener (Red <-> Blue)
  roleChangeBtn?.addEventListener('click', () => {
    currentVariant = currentVariant === 'red' ? 'blue' : 'red';

    if (imgContainer) {
      imgContainer.style.opacity = '0';
      imgContainer.style.transform = 'scale(0.95)';
    }

    setTimeout(() => {
      const item = divisionsData[currentIndex];
      if (imgEl) {
        imgEl.src = currentVariant === 'red' ? item.image_red : item.image_blue;
        imgEl.alt = `${item.id} (${currentVariant})`;
      }

      if (imgContainer) {
        imgContainer.style.opacity = '1';
        imgContainer.style.transform = 'scale(1)';
      }
    }, 150);
  });

  roleChangeBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      roleChangeBtn.click();
    }
  });

  // Prev / Next button listeners
  document.getElementById('div-prev-btn')?.addEventListener('click', () => {
    const nextIdx = (currentIndex - 1 + total) % total;
    updateDivision(nextIdx, -1);
  });

  document.getElementById('div-next-btn')?.addEventListener('click', () => {
    const nextIdx = (currentIndex + 1) % total;
    updateDivision(nextIdx, 1);
  });

  // Direct pill click listeners for the 3 visible slots
  pillSlots.forEach((btn) => {
    btn?.addEventListener('click', () => {
      const targetIdx = parseInt(btn.getAttribute('data-div-idx') || '0', 10);
      if (targetIdx !== currentIndex) {
        const dir = targetIdx > currentIndex ? 1 : -1;
        updateDivision(targetIdx, dir);
      }
    });
  });

  // Touch swipe support for mobile
  let touchStartX = 0;
  let touchEndX = 0;
  const sectionEl = document.getElementById('divisions');

  sectionEl?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  sectionEl?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchEndX - touchStartX;
    if (diff < -40) {
      // Swiped left -> next
      const nextIdx = (currentIndex + 1) % total;
      updateDivision(nextIdx, 1);
    } else if (diff > 40) {
      // Swiped right -> prev
      const prevIdx = (currentIndex - 1 + total) % total;
      updateDivision(prevIdx, -1);
    }
  }, { passive: true });
</script>